# Names only. Never commit real values.
# Server-side only. Must never be exposed to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Production must use supabase or leave it unset.
ACTIONS_STORE=
# Non-production only. Ignored when NODE_ENV is production.
# Stub stock for local runs: normal (default), down, empty, or malformed.
STUB_STOCK_MODE=
# Demo identity used until real auth exists (see docs/technical-design.md section 8).
DEMO_USER_ID=demo-leader
